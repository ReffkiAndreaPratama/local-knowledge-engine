# Local Knowledge Engine Configuration
# Copy to .env only if you need to override the defaults. Everything here has a
# safe default in backend/app/core/config.py.

# Application
APP_NAME=Local Knowledge Engine
APP_ENV=development
DEBUG=true
# Keep the backend on loopback. There is no authentication.
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/knowledge.db
# PostgreSQL is NOT supported as a search backend in this MVP: FTS5 is SQLite-only.

# Security
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Processing
MAX_FILE_SIZE_MB=100
# Comma-separated absolute paths. Empty means the current user's home directory.
ALLOWED_IMPORT_DIRS=
CHUNK_SIZE=512
CHUNK_OVERLAP=50
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx,.csv,.json,.html,.py,.js,.ts,.jsx,.tsx,.java,.cpp,.c,.h,.go,.rs,.rb,.php

# Embeddings (optional semantic search)
# Requires `pip install -r requirements-semantic.txt` and a one-time
# `python scripts/download_embedding_model.py`.
ENABLE_SEMANTIC_SEARCH=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# AI Assistant (optional)
# AI_PROVIDER: ollama (local) or openai (any OpenAI-compatible endpoint:
# LM Studio, vLLM, OpenAI itself). Anthropic is not implemented.
ENABLE_AI_ASSISTANT=false
AI_PROVIDER=ollama
AI_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# API keys are read from the environment only. They are never written to the
# database and never returned by the API.
# OPENAI_API_KEY=

# Privacy
DISABLE_TELEMETRY=true
REQUIRE_AI_CONSENT=true
STORE_SEARCH_HISTORY=true
